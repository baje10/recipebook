rimary\">Instruction 22 (unneed)</InputLabel>\r\n                <Input\r\n                  type = \"text\"\r\n                  onChange={(e) => setInstruction21(e.target.value)}\r\n                  id = 'instruction21'\r\n                  name = 'instruction21'\r\n                />\r\n              </FormControl>\r\n              <FormControl onChange={handleShowInstruction24} hidden={!showInstruction23} className={(classes.margin, classes.textField)}>\r\n                <InputLabel color=\"primary\">Instruction 23 (unneed)</InputLabel>\r\n                <Input\r\n                  type = \"text\"\r\n                  onChange={(e) => setInstruction22(e.target.value)}\r\n                  id = 'instruction22'\r\n                  name = 'instruction22'\r\n                />\r\n              </FormControl>\r\n              <FormControl onChange={handleShowInstruction25} hidden={!showInstruction24} className={(classes.margin, classes.textField)}>\r\n                <InputLabel color=\"primary\">Instruction 24 (unneed)</InputLabel>\r\n                <Input\r\n                  type = \"text\"\r\n                  onChange={(e) => setInstruction23(e.target.value)}\r\n                  id = 'instruction23'\r\n                  name = 'instruction23'\r\n                />\r\n              </FormControl>\r\n              <FormControl onChange={handleShowInstruction26} hidden={!showInstruction25} className={(classes.margin, classes.textField)}>\r\n                <InputLabel color=\"primary\">Instruction 25 (unneed)</InputLabel>\r\n                <Input\r\n                  type = \"text\"\r\n                  onChange={(e) => setInstruction24(e.target.value)}\r\n                  id = 'instruction24'\r\n                  name = 'instruction24'\r\n                />\r\n              </FormControl>\r\n              <FormControl hidden={!showInstruction26} className={(classes.margin, classes.textField)}>\r\n                <InputLabel color=\"primary\">Instruction 26 (unneed)</InputLabel>\r\n                <Input\r\n                  type = \"text\"\r\n                  onChange={(e) => setInstruction25(e.target.value)}\r\n                  id = 'instruction25'\r\n                  name = 'instruction25'\r\n                />\r\n              </FormControl>\r\n              <div style={{marginTop: \"1rem\"}} className={classes.root}>\r\n                <input\r\n                  accept=\"image/*\"\r\n                  required\r\n                  className={classes.input}\r\n                  id=\"photo\"\r\n                  type=\"file\"\r\n                  name = 'photo'\r\n                  onChange={(e) => setPhoto(e.target.files[0])}\r\n                />\r\n                <label className=\"addButtons\" htmlFor=\"photo\">\r\n                  <Button variant=\"contained\" color=\"primary\" component=\"span\" startIcon={<CloudUploadIcon />}>\r\n                    Upload Recipe Photo\r\n                  </Button>\r\n                </label>\r\n              </div>\r\n              <div style={{marginTop: \"1rem\"}} className={classes.root}>\r\n                <input\r\n                accept=\"image/*\"\r\n                required\r\n                className={classes.input}\r\n                id=\"photo1\"\r\n                type=\"file\"\r\n                name = 'photo1'\r\n                onChange={(e) => setPhoto1(e.target.files[0])}\r\n                />\r\n                <label className=\"addButtons\" htmlFor=\"photo1\">\r\n                  <Button variant=\"contained\" color=\"primary\" component=\"span\" startIcon={<CloudUploadIcon />}>\r\n                    Upload Details Photo\r\n                  </Button>\r\n                </label>\r\n              </div>\r\n              <Button style={{width:'100%', marginTop: \"1rem\"}} startIcon={<SaveIcon />} variant=\"contained\" type=\"submit\">Save Recipe</Button>\r\n              <Button onClick={handleCloseModalRecipe} style={{width:'100%', marginTop: \"1rem\"}} color=\"primary\" startIcon={<ClearIcon/>} variant=\"contained\">Cancel</Button>\r\n            </form>\r\n          </div>\r\n        </div>\r\n      </Fade>\r\n    </Modal>\r\n    </>\r\n  )\r\n}\r\n\r\nexport default AdminPage;\r\n","C:\\Users\\PC\\Projects\\recipebook\\src\\routes\\adminRoute.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\routes\\loggedInRoute.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\components\\footer.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\reducers\\userReducers.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\reducers\\categoryReducers.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\reducers\\recipeReducers.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\reducers\\ingredientReducer.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\combineActions.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\types.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\actions\\index.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\actions\\ingredient.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\actions\\user.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\actions\\recipe.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\actions\\category.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\categsHome.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\home.js",["159"],"C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\newRecipes.js",["160"],"C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\categories.js",["161","162"],"import React, { useState, useEffect, useCallback } from 'react';\r\n\r\n//redux\r\nimport { useSelector, useDispatch } from 'react-redux';\r\nimport { rbook } from '../redux/combineActions';\r\n\r\n//navigation\r\nimport { Link, useLocation } from 'react-router-dom';\r\n\r\n//material-ui\r\nimport { makeStyles } from '@material-ui/core/styles';\r\nimport Card from '@material-ui/core/Card';\r\nimport CardActions from '@material-ui/core/CardActions';\r\nimport CardContent from '@material-ui/core/CardContent';\r\nimport CardMedia from '@material-ui/core/CardMedia';\r\nimport Button from '@material-ui/core/Button';\r\nimport Typography from '@material-ui/core/Typography';\r\nimport Rating from '@material-ui/lab/Rating';\r\nimport CircularProgress from '@material-ui/core/CircularProgress';\r\nimport Pagination from \"@material-ui/lab/Pagination\";\r\nimport Box from '@material-ui/core/Box';\r\nimport Select from '@material-ui/core/Select';\r\nimport { useMediaQuery } from '@material-ui/core';\r\n\r\nconst useStyles = makeStyles({\r\n  root: {\r\n    maxHeight: \"17rem\",\r\n    maxWidth: \"8rem\",\r\n    marginLeft: '.7rem',\r\n    whiteSpace: 'nowrap',\r\n    marginTop: '1rem'\r\n  },\r\n  root1: {\r\n    maxHeight: \"35rem\",\r\n    width: \"15rem\",\r\n    marginTop: '1rem',\r\n    marginLeft: '.7rem',\r\n    whiteSpace: 'nowrap'\r\n  },\r\n  paginator: {\r\n    justifyContent: \"center\",\r\n    padding: \"10px\",\r\n    marginTop:'1%',\r\n  },\r\n  viewAllBtn: {\r\n    marginTop: '2%',\r\n    color: '#8b664c',\r\n    border: '1px solid #8b664c',\r\n    '&:hover': {\r\n      borderColor: '#765742',\r\n      color: '#765742',\r\n    }\r\n  }\r\n});\r\n\r\nconst Categories = () => {\r\n  const lowReso = useMediaQuery('(max-width: 519px)');\r\n\r\n  const [pageDetails, setPageDetails] = useState(null);\r\n  const [pageSize] = useState(5);\r\n  const [categListPaginate, setCategListPaginate] = useState([]);\r\n\r\n  document.title='Peso Palate | Categories';\r\n\r\n  const { loading, error } = useSelector(state => state.listCategories);\r\n\r\n  const dispatch = useDispatch();\r\n  const classes = useStyles();\r\n  const location = useLocation();\r\n\r\n  const params = new URLSearchParams(location.search);\r\n  const search = params.get('keyword') ?? '';\r\n\r\n\r\n  const handleCategListPaginate = useCallback(\r\n    (pageIndex = 1) => {\r\n      dispatch(rbook.category.listAllCategorysPaginate(pageIndex, pageSize, search))\r\n        .then((data) => {\r\n          if (data) {\r\n            console.log('DATAAA CATEGORY', data.docs)\r\n            setCategListPaginate(data.docs);\r\n            setPageDetails({\r\n              pageIndex: data.page,\r\n              pageSize: data.limit,\r\n              totalPages: data.totalPages,\r\n              totalDocs: data.totalDocs\r\n            });\r\n          }\r\n        })\r\n    },\r\n    [dispatch, pageSize, search],\r\n  );\r\n\r\n  useEffect(() => {\r\n    handleCategListPaginate();\r\n  }, [handleCategListPaginate]);\r\n\r\n  const handleChangePageIndex = (event, value) => {\r\n    handleCategListPaginate(value);\r\n  };\r\n\r\n\r\n  const createBanana = (category, idx) => {\r\n    if ( !lowReso ) {\r\n      return (\r\n        <Card style = {{ display: loading && 'none' }} key={idx} className={classes.root1}>\r\n           <CardMedia\r\n             component=\"img\"\r\n             alt={category.name}\r\n             height=\"200\"\r\n             image={`/api/category/photo/${category._id}`}\r\n             title={category.name}\r\n           />\r\n           <CardContent>\r\n             <Typography gutterBottom variant=\"h6\">\r\n               <Box\r\n                 component=\"p\"\r\n                 my={1}\r\n                 textOverflow=\"ellipsis\"\r\n                 overflow=\"hidden\"\r\n               >\r\n                 {category.name}\r\n               </Box>\r\n             </Typography>\r\n           </CardContent>\r\n           <CardActions>\r\n             <Link to = {`/recipes?category=${category._id}`}>\r\n               <Button className={classes.viewAllBtn} variant=\"outlined\">Check it out</Button>\r\n             </Link>\r\n           </CardActions>\r\n         </Card>\r\n      );\r\n    } else {\r\n      return (\r\n        <Card style = {{ display: loading && 'none' }} key={idx} className={classes.root}>\r\n           <Link to = {`/recipes?category=${category._id}`}>\r\n             <CardMedia\r\n               component=\"img\"\r\n               alt={category.name}\r\n               height=\"150\"\r\n               image={`/api/category/photo/${category._id}`}\r\n               title={category.name}\r\n             />\r\n           </Link>\r\n           <CardContent>\r\n             <Typography>\r\n                <Box\r\n                    component=\"div\"\r\n                    my={0}\r\n                    textOverflow=\"ellipsis\"\r\n                    overflow=\"hidden\"\r\n                    >\r\n                    <b>{category.name}</b>\r\n                </Box>\r\n             </Typography>\r\n           </CardContent>\r\n         </Card>\r\n      );\r\n    }\r\n  };\r\n\r\n\r\n  return (\r\n    <>\r\n      <center className = 'welcomeTitle'>Categories</center>\r\n      <div className = 'home-container'>\r\n\r\n        {loading && <CircularProgress color='inherit' className = 'loading1' />}\r\n        {error && <div>{error}</div>}\r\n\r\n        {categListPaginate.length === 0 && !loading &&\r\n          <div style = {{fontSize: '4rem'}} >No categories found</div>\r\n        }\r\n        {categListPaginate.map((category, index) => (\r\n          createBanana(category, index)\r\n        ))}\r\n      </div>\r\n\r\n      {pageDetails && pageDetails.totalDocs <= pageDetails.pageSize ?\r\n        (\r\n         null\r\n        ) : (\r\n          <Pagination\r\n            style = {{ display: loading && 'none' }}\r\n            count={pageDetails && pageDetails.totalPages}\r\n            page={pageDetails && pageDetails.pageIndex}\r\n            defaultPage={1}\r\n            color=\"primary\"\r\n            size=\"large\"\r\n            onChange={handleChangePageIndex}\r\n            classes={{ ul: classes.paginator }}\r\n          />\r\n        )\r\n      }\r\n    </>\r\n  )\r\n}\r\n\r\nexport default Categories;\r\n",{"ruleId":"163","replacedBy":"164"},{"ruleId":"165","replacedBy":"166"},{"ruleId":"167","sever