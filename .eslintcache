0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"68"},{"filePath":"113","messages":"114","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"68"},{"filePath":"115","messages":"116","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"68"},{"filePath":"117","messages":"118","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"68"},{"filePath":"119","messages":"120","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"68"},{"filePath":"121","messages":"122","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"68"},{"filePath":"123","messages":"124","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"68"},{"filePath":"125","messages":"126","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"127"},{"filePath":"128","messages":"129","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"130","messages":"131","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"132","messages":"133","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"134","usedDeprecatedRules":"68"},"C:\\Users\\PC\\Projects\\recipebook\\src\\index.js",[],["135","136"],"C:\\Users\\PC\\Projects\\recipebook\\src\\App.js",["137"],"import React from 'react';\r\nimport { BrowserRouter, Route, Switch } from 'react-router-dom';\r\n\r\n//styling\r\nimport './App.css'\r\n\r\n//components\r\nimport Navbar from './components/navbar';\r\nimport NavbarLow from './components/navbarLow';\r\nimport Footer from './components/footer';\r\n\r\n//pages\r\nimport Signup from './pages/signup';\r\nimport Signin from './pages/signin';\r\nimport About from './pages/about';\r\nimport Default from './pages/default';\r\nimport RecipeDetails from './pages/recipeDetails';\r\nimport AllRecipe from './pages/allRecipe';\r\nimport Categories from './pages/categories';\r\nimport MainHome from './pages/mainHomepage';\r\n\r\n//adminPage\r\nimport AdminPage from './adminPage/adminPage';\r\n\r\n//routing\r\nimport PrivateRoute from './routes/privateRoute';\r\nimport AdminRoute from './routes/adminRoute';\r\nimport LoggedInRoute from './routes/loggedInRoute';\r\n\r\n//material-ui\r\nimport { useMediaQuery } from '@material-ui/core';\r\n\r\nconst App = () => {\r\n  const showNavbarLow = useMediaQuery('(max-width: 1020px)');\r\n\r\n  return (\r\n    <BrowserRouter>\r\n      <br/>\r\n      { showNavbarLow ? <NavbarLow/> : <Navbar/> }\r\n      <Switch>\r\n         <Route path='/' exact={true} component={MainHome}/>\r\n         <LoggedInRoute path='/signin' component={Signin}/>\r\n         <Route path='/recipes' component={AllRecipe}/>\r\n         <Route path='/categories' component={Categories}/>\r\n         <LoggedInRoute path='/signup' component={Signup}/>\r\n         <Route path='/about' component={About}/>\r\n         <Route path='/detail/:id' component={RecipeDetails}/>\r\n         <AdminRoute path='/admin' component={AdminPage}/>\r\n         <Route component={Default}/>\r\n      </Switch>\r\n      <Footer/>\r\n    </BrowserRouter>\r\n  )\r\n}\r\n\r\nexport default App;\r\n","C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\store.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\components\\navbarLow.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\signup.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\components\\navbar.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\default.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\about.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\allRecipe.js",["138"],"import React, { useState, useEffect, useCallback } from 'react';\r\n\r\n//redux\r\nimport { useSelector, useDispatch } from 'react-redux';\r\nimport { rbook } from '../redux/combineActions';\r\n\r\n//navigation\r\nimport { Link, useHistory, useLocation } from 'react-router-dom';\r\n\r\n//material-ui\r\nimport { makeStyles } from '@material-ui/core/styles';\r\nimport Card from '@material-ui/core/Card';\r\nimport CardActions from '@material-ui/core/CardActions';\r\nimport CardContent from '@material-ui/core/CardContent';\r\nimport CardMedia from '@material-ui/core/CardMedia';\r\nimport Button from '@material-ui/core/Button';\r\nimport Typography from '@material-ui/core/Typography';\r\nimport Rating from '@material-ui/lab/Rating';\r\nimport CircularProgress from '@material-ui/core/CircularProgress';\r\nimport Pagination from \"@material-ui/lab/Pagination\";\r\nimport Box from '@material-ui/core/Box';\r\nimport Select from '@material-ui/core/Select';\r\nimport { useMediaQuery } from '@material-ui/core';\r\n\r\nconst useStyles = makeStyles({\r\n  root: {\r\n    maxHeight: \"17rem\",\r\n    maxWidth: \"8rem\",\r\n    marginLeft: '.7rem',\r\n    whiteSpace: 'nowrap',\r\n    marginTop: '1rem'\r\n  },\r\n  root1: {\r\n    maxHeight: \"35rem\",\r\n    maxWidth: \"15rem\",\r\n    marginTop: '1rem',\r\n    marginLeft: '.7rem',\r\n    whiteSpace: 'nowrap'\r\n  },\r\n  paginator: {\r\n    justifyContent: \"center\",\r\n    padding: \"10px\",\r\n    marginTop:'1%',\r\n  }\r\n});\r\n\r\nconst AllRecipe = () => {\r\n  const lowReso = useMediaQuery('(max-width: 519px)');\r\n\r\n  const [recipeList, setRecipeList] = useState([]);\r\n  const [pageDetails, setPageDetails] = useState(null);\r\n  const [pageSize] = useState(5);\r\n  const [categList, setCategList] = useState([]);\r\n  const [category, setCategory] = useState('');\r\n\r\n  document.title='Peso Palate | All Recipes';\r\n\r\n  const { loading, error } = useSelector(state => state.recipeListAll);\r\n\r\n  const dispatch = useDispatch();\r\n  const classes = useStyles();\r\n  const history = useHistory();\r\n  const location = useLocation();\r\n\r\n  const params = new URLSearchParams(location.search);\r\n  const search = params.get('keyword') ?? '';\r\n  const categ = params.get('category') ?? '';\r\n\r\n  const handleRecipeList = useCallback(\r\n    (pageIndex = 1) => {\r\n      dispatch(rbook.recipe.listAllRecipes(pageIndex, pageSize, search, categ))\r\n        .then((data) => {\r\n          if (data) {\r\n            setRecipeList(data.docs);\r\n            setPageDetails({\r\n              pageIndex: data.page,\r\n              pageSize: data.limit,\r\n              totalPages: data.totalPages,\r\n              totalDocs: data.totalDocs\r\n            });\r\n          }\r\n        })\r\n    },\r\n    [dispatch, pageSize, search, categ],\r\n  );\r\n\r\n  const handleCategoryList = useCallback(\r\n    () => {\r\n      dispatch(rbook.category.listCategories())\r\n        .then((data) => {\r\n          if (data) {\r\n            setCategList(data);\r\n          }\r\n        })\r\n    },\r\n    [dispatch],\r\n  );\r\n\r\n  useEffect(() => {\r\n    handleCategoryList();\r\n  }, [handleCategoryList]);\r\n\r\n  useEffect(() => {\r\n    handleRecipeList();\r\n  }, [handleRecipeList]);\r\n\r\n  const handleChangePageIndex = (event, value) => {\r\n    handleRecipeList(value);\r\n  };\r\n\r\n  const handleCategoryHandler = (e) => {\r\n    if(search === '') {\r\n      history.push('/recipes?category=' + e.target.value);\r\n    } else {\r\n      history.push('/recipes?keyword=' + search + '&category=' + e.target.value);\r\n    }\r\n    setCategory(e.target.value);\r\n    console.log('CATEGORY NAME', e.target.value);\r\n  }\r\n\r\n  const createBanana = (recipe, idx) => {\r\n    if ( !lowReso ) {\r\n      return (\r\n        <Card style = {{ display: loading && 'none' }} key={idx} className={classes.root1}>\r\n           <CardMedia\r\n             component=\"img\"\r\n             alt={recipe.name}\r\n             height=\"200\"\r\n             image={`/api/recipe/photo/${recipe._id}`}\r\n             title={recipe.name}\r\n           />\r\n           <CardContent>\r\n             <Typography gutterBottom variant=\"h6\">\r\n               <Box\r\n                 component=\"p\"\r\n                 my={2}\r\n                 textOverflow=\"ellipsis\"\r\n                 overflow=\"hidden\"\r\n               >\r\n                 {recipe.name}\r\n               </Box>\r\n             </Typography>\r\n             <Typography variant=\"body2\" color=\"textSecondary\" component=\"p\">\r\n               <Rating precision={.2} readOnly value={recipe.rating.toFixed(1)}/> <div style = {{fontSize: \"1.5rem\"}}>{recipe.rating.toFixed(1)}</div>\r\n             </Typography>\r\n             <Typography variant=\"body2\" color=\"textSecondary\" component=\"p\">\r\n               <div style = {{fontSize: \"1rem\"}}>Number of reviews: {recipe.numReviews}</div>\r\n             </Typography>\r\n           </CardContent>\r\n           <CardActions>\r\n             <Link to = {`/detail/${recipe._id}`}>\r\n               <Button size=\"small\" color=\"primary\">\r\n                 Read more\r\n               </Button>\r\n             </Link>\r\n           </CardActions>\r\n         </Card>\r\n      );\r\n    } else {\r\n      return (\r\n        <Card style = {{ display: loading && 'none' }} key={idx} className={classes.root}>\r\n           <Link to = {`/detail/${recipe._id}`}>\r\n             <CardMedia\r\n               component=\"img\"\r\n               alt={recipe.name}\r\n               height=\"150\"\r\n               image={`/api/recipe/photo/${recipe._id}`}\r\n               title={recipe.name}\r\n             />\r\n           </Link>\r\n           <CardContent>\r\n             <Typography>\r\n             <Box\r\n               component=\"div\"\r\n               my={0}\r\n               textOverflow=\"ellipsis\"\r\n               overflow=\"hidden\"\r\n             >\r\n               <b>{recipe.name}</b>\r\n             </Box>\r\n             </Typography>\r\n           </CardContent>\r\n         </Card>\r\n      );\r\n    }\r\n  };\r\n\r\n\r\n  return (\r\n    <>\r\n      <center className = 'welcomeTitle'>All recipes</center>\r\n      <center style={{ display: loading && 'none' }} >\r\n        <Select\r\n          style= {{width: \"50%\"}}\r\n          native\r\n          required\r\n          variant=\"outlined\"\r\n          onChange={handleCategoryHandler}\r\n          value={categ}\r\n          inputProps={{\r\n            name: 'category',\r\n            id: 'category',\r\n          }}\r\n        >\r\n          <option value = \"\">Category Filter</option>\r\n          {\r\n           categList.map((c, i) => (\r\n             <option key={i} value={c._id}>\r\n                 {c.name}\r\n             </option>\r\n          ))}\r\n        </Select>\r\n      </center>\r\n      <div className = 'home-container'>\r\n\r\n        {loading && <CircularProgress color='inherit' className = 'loading1' />}\r\n        {error && <div>{error}</div>}\r\n\r\n        {recipeList.length === 0 && !loading &&\r\n          <div style = {{fontSize: '4rem'}} >No recipes found</div>\r\n        }\r\n        {recipeList.map((recipe, index) => (\r\n          createBanana(recipe, index)\r\n        ))}\r\n      </div>\r\n\r\n      {pageDetails && pageDetails.totalDocs <= pageDetails.pageSize ?\r\n        (\r\n         null\r\n        ) : (\r\n          <Pagination\r\n            style = {{ display: loading && 'none' }}\r\n            count={pageDetails && pageDetails.totalPages}\r\n            page={pageDetails && pageDetails.pageIndex}\r\n            defaultPage={1}\r\n            color=\"primary\"\r\n            size=\"large\"\r\n            onChange={handleChangePageIndex}\r\n            classes={{ ul: classes.paginator }}\r\n          />\r\n        )\r\n      }\r\n    </>\r\n  )\r\n}\r\n\r\nexport default AllRecipe;\r\n","C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\signin.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\mainHomepage.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\routes\\privateRoute.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\recipeDetails.js",["139","140"],"C:\\Users\\PC\\Projects\\recipebook\\src\\adminPage\\adminPage.js",["141","142","143","144","145","146","147","148","149","150","151","152","153","154","155","156","157"],"C:\\Users\\PC\\Projects\\recipebook\\src\\routes\\adminRoute.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\routes\\loggedInRoute.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\components\\footer.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\reducers\\userReducers.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\reducers\\categoryReducers.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\reducers\\recipeReducers.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\reducers\\ingredientReducer.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\combineActions.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\types.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\actions\\index.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\actions\\ingredient.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\actions\\user.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\actions\\recipe.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\redux\\actions\\category.js",[],"C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\categsHome.js",[],["158","159"],"C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\home.js",["160"],"C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\newRecipes.js",["161"],"C:\\Users\\PC\\Projects\\recipebook\\src\\pages\\categories.js",["162","163"],"import React, { useState, useEffect, useCallback } from 'react';\r\n\r\n//redux\r\nimport { useSelector, useDispatch } from 'react-redux';\r\nimport { rbook } from '../redux/combineActions';\r\n\r\n//navigation\r\nimport { Link, useLocation } from 'react-router-dom';\r\n\r\n//material-ui\r\nimport { makeStyles } from '@material-ui/core/styles';\r\nimport Card from '@material-ui/core/Card';\r\nimport CardActions from '@material-ui/core/CardActions';\r\nimport CardContent from '@material-ui/core/CardContent';\r\nimport CardMedia from '@material-ui/core/CardMedia';\r\nimport Button from '@material-ui/core/Button';\r\nimport Typography from '@material-ui/core/Typography';\r\nimport Rating from '@material-ui/lab/Rating';\r\nimport CircularProgress from '@material-ui/core/CircularProgress';\r\nimport Pagination from \"@material-ui/lab/Pagination\";\r\nimport Box from '@material-ui/core/Box';\r\nimport Select from '@material-ui/core/Select';\r\nimport { useMediaQuery } from '@material-ui/core';\r\n\r\nconst useStyles = makeStyles({\r\n  root: {\r\n    maxHeight: \"17rem\",\r\n    maxWidth: \"8rem\",\r\n    marginLeft: '.7rem',\r\n    whiteSpace: 'nowrap',\r\n    marginTop: '1rem'\r\n  },\r\n  root1: {\r\n    maxHeight: \"35rem\",\r\n    width: \"15rem\",\r\n    marginTop: '1rem',\r\n    marginLeft: '.7rem',\r\n    whiteSpace: 'nowrap'\r\n  },\r\n  paginator: {\r\n    justifyContent: \"center\",\r\n    padding: \"10px\",\r\n    marginTop:'1%',\r\n  },\r\n  viewAllBtn: {\r\n    marginTop: '2%',\r\n    color: '#8b664c',\r\n    border: '1px solid #8b664c',\r\n    '&:hover': {\r\n      borderColor: '#765742',\r\n      color: '#765742',\r\n    }\r\n  }\r\n});\r\n\r\nconst Categories = () => {\r\n  const lowReso = useMediaQuery('(max-width: 519px)');\r\n\r\n  const [pageDetails, setPageDetails] = useState(null);\r\n  const [pageSize] = useState(5);\r\n  const [categListPaginate, setCategListPaginate] = useState([]);\r\n\r\n  document.title='Peso Palate | Categories';\r\n\r\n  const { loading, error } = useSelector(state => state.listCategories);\r\n\r\n  const dispatch = useDispatch();\r\n  const classes = useStyles();\r\n  const location = useLocation();\r\n\r\n  const params = new URLSearchParams(location.search);\r\n  const search = params.get('keyword') ?? '';\r\n\r\n\r\n  const handleCategListPaginate = useCallback(\r\n    (pageIndex = 1) => {\r\n      dispatch(rbook.category.listAllCategorysPaginate(pageIndex, pageSize, search))\r\n        .then((data) => {\r\n          if (data) {\r\n            console.log('DATAAA CATEGORY', data.docs)\r\n            setCategListPaginate(data.docs);\r\n            setPageDetails({\r\n              pageIndex: data.page,\r\n              pageSize: data.limit,\r\n              totalPages: data.totalPages,\r\n              totalDocs: data.totalDocs\r\n            });\r\n          }\r\n        })\r\n    },\r\n    [dispatch, pageSize, search],\r\n  );\r\n\r\n  useEffect(() => {\r\n    handleCategListPaginate();\r\n  }, [handleCategListPaginate]);\r\n\r\n  const handleChangePageIndex = (event, value) => {\r\n    handleCategListPaginate(value);\r\n  };\r\n\r\n\r\n  const createBanana = (category, idx) => {\r\n    if ( !lowReso ) {\r\n      return (\r\n        <Card style = {{ display: loading && 'none' }} key={idx} className={classes.root1}>\r\n           <CardMedia\r\n             component=\"img\"\r\n             alt={category.name}\r\n             height=\"200\"\r\n             image={`/api/category/photo/${category._id}`}\r\n             title={category.name}\r\n           />\r\n           <CardContent>\r\n             <Typography gutterBottom variant=\"h6\">\r\n               <Box\r\n                 component=\"p\"\r\n                 my={1}\r\n                 textOverflow=\"ellipsis\"\r\n                 overflow=\"hidden\"\r\n               >\r\n                 {category.name}\r\n               </Box>\r\n             </Typography>\r\n           </CardContent>\r\n           <CardActions>\r\n             <Link to = {`/recipes?category=${category._id}`}>\r\n               <Button className={classes.viewAllBtn} variant=\"outlined\">Check it out</Button>\r\n             </Link>\r\n           </CardActions>\r\n         </Card>\r\n      );\r\n    } else {\r\n      return (\r\n        <Card style = {{ display: loading && 'none' }} key={idx} className={classes.root}>\r\n           <Link to = {`/recipes?category=${category._id}`}>\r\n             <CardMedia\r\n               component=\"img\"\r\n               alt={category.name}\r\n               height=\"150\"\r\n               image={`/api/category/photo/${category._id}`}\r\n               title={category.name}\r\n             />\r\n           </Link>\r\n           <CardContent>\r\n             <Typography>\r\n                <Box\r\n                    component=\"div\"\r\n                    my={0}\r\n                    textOverflow=\"ellipsis\"\r\n                    overflow=\"hidden\"\r\n                    >\r\n                    <b>{category.name}</b>\r\n                </Box>\r\n             </Typography>\r\n           </CardContent>\r\n         </Card>\r\n      );\r\n    }\r\n  };\r\n\r\n\r\n  return (\r\n    <>\r\n      <center className = 'welcomeTitle'>Categories</center>\r\n      <div className = 'home-container'>\r\n\r\n        {loading && <CircularProgress color='inherit' className = 'loading1' />}\r\n        {error && <div>{error}</div>}\r\n\r\n        {categListPaginate.length === 0 && !loading &&\r\n          <div style = {{fontSize: '4rem'}} >No categories found</div>\r\n        }\r\n        {categListPaginate.map((category, index) => (\r\n          createBanana(category, index)\r\n        ))}\r\n      </div>\r\n\r\n      {pageDetails && pageDetails.totalDocs <= pageDetails.pageSize ?\r\n        (\r\n         null\r\n        ) : (\r\n          <Pagination\r\n            style = {{ display: loading && 'none' }}\r\n            count={pageDetails && pageDetails.totalPages}\r\n            page={pageDetails && pageDetails.pageIndex}\r\n            defaultPage={1}\r\n            color=\"primary\"\r\n            size=\"large\"\r\n            onChange={handleChangePageIndex}\r\n            classes={{ ul: classes.paginator }}\r\n          />\r\n        )\r\n      }\r\n    </>\r\n  )\r\n}\r\n\r\nexport default Categories;\r\n",{"ruleId":"164","replacedBy":"165"},{"ruleId":"166","replacedBy":"167"},{"ruleId":"168","severity":1,"message":"169","line":26,"column":8,"nodeType":"170","messageId":"171","endLine":26,"endColumn":20},{"ruleId":"168","severity":1,"message":"172","line":54,"column":10,"nodeType":"170","messageId":"171","endLine":54,"endColumn":18},{"ruleId":"168","severity":1,"message":"173","line":71,"column":10,"nodeType":"170","messageId":"171","endLine":71,"endColumn":17},{"ruleId":"174","severity":1,"message":"175","line":278,"column":6,"nodeType":"176","endLine":278,"endColumn":47,"suggestions":"177"},{"ruleId":"168","severity":1,"message":"178","line":332,"column":29,"nodeType":"170","messageId":"171","endLine":332,"endColumn":41},{"ruleId":"168","severity":1,"message":"179","line":332,"column":43,"nodeType":"170","messageId":"171","endLine":332,"endColumn":57},{"ruleId":"168","severity":1,"message":"180","line":332,"column":59,"nodeType":"170","messageId":"171","endLine":332,"endColumn":75},{"ruleId":"168","severity":1,"message":"181","line":333,"column":28,"nodeType":"170","messageId":"171","endLine":333,"endColumn":41},{"ruleId":"168","severity":1,"message":"182","line":333,"column":43,"nodeType":"170","messageId":"171","endLine":333,"endColumn":58},{"ruleId":"183","severity":1,"message":"184","line":1003,"column":48,"nodeType":"185","messageId":"186","endLine":1003,"endColumn":50},{"ruleId":"183","severity":1,"message":"184","line":1003,"column":62,"nodeType":"185","messageId":"186","endLine":1003,"endColumn":64},{"ruleId":"183","severity":1,"message":"184","line":1010,"column":48,"nodeType":"185","messageId":"186","endLine":1010,"endColumn":50},{"ruleId":"183","severity":1,"message":"184","line":1010,"column":62,"nodeType":"185","messageId":"